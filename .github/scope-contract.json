{
  "schemaVersion": 1,
  "scopes": [
    "analyzer",
    "autobuilder",
    "ci",
    "cli",
    "core",
    "docs",
    "github",
    "gitlab",
    "go-server",
    "infra",
    "ir",
    "model",
    "rules"
  ],
  "compatibility": {
    "forbiddenPairs": [
      ["cli", "analyzer"],
      ["cli", "autobuilder"],
      ["cli", "core"],
      ["cli", "go-server"],
      ["cli", "ir"],
      ["cli", "model"],
      ["cli", "rules"]
    ],
    "exclusiveGroups": [
      ["github", "gitlab", "infra"]
    ],
    "companions": {
      "github": ["docs", "ci"],
      "gitlab": ["docs", "ci"],
      "infra": ["docs", "ci"]
    }
  },
  "releaseScopes": {
    "analyzer": [
      "analyzer",
      "core",
      "ir",
      "model"
    ],
    "autobuilder": [
      "autobuilder",
      "core"
    ],
    "go-server": [
      "go-server",
      "ir"
    ]
  },
  "ownership": {
    "ignoredRoots": [
      "formal"
    ],
    "overrides": [
      {
        "scope": "ci",
        "globs": [
          "release-notes-transform.cjs",
          "**/.releaserc.cjs"
        ]
      }
    ],
    "roots": {
      "rules": {
        "defaultScope": "rules"
      },
      "model": {
        "defaultScope": "model"
      },
      "github": {
        "defaultScope": "github"
      },
      "gitlab": {
        "defaultScope": "gitlab"
      },
      "infra": {
        "defaultScope": "infra"
      },
      "cli": {
        "defaultScope": "cli"
      },
      "core": {
        "defaultScope": "core",
        "rules": [
          {
            "scope": "autobuilder",
            "globs": [
              "opentaint-jvm-autobuilder/**"
            ]
          },
          {
            "scope": "go-server",
            "globs": [
              "opentaint-ir/go/go-ssa-server/**"
            ]
          },
          {
            "scope": "ir",
            "globs": [
              "opentaint-ir/go/proto/**"
            ]
          },
          {
            "scope": "analyzer",
            "globs": [
              "src/**",
              "samples/**",
              "opentaint-dataflow-core/**",
              "opentaint-ir/**",
              "opentaint-jvm-sast-dataflow/**",
              "opentaint-jvm-sast-project/**",
              "opentaint-jvm-sast-se-api/**",
              "opentaint-go-querylang/**",
              "opentaint-java-querylang/**",
              "opentaint-config/**",
              "opentaint-configuration-rules/**",
              "opentaint-utils/common-util/**",
              "opentaint-utils/opentaint-jvm-util/**"
            ],
            "excludeGlobs": [
              "opentaint-ir/go/go-ssa-server/**",
              "opentaint-ir/go/proto/**"
            ]
          }
        ]
      },
      ".github": {
        "defaultScope": "ci"
      }
    },
    "documentation": {
      "scope": "docs",
      "rootDirectories": [
        "public",
        "docs",
        "skills",
        "skills-templates",
        "scripts",
        "logos",
        ".claude-plugin",
        ".codex-plugin"
      ],
      "basenames": [
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "LICENSE.md"
      ],
      "extensions": [
        ".svg",
        ".png"
      ],
      "rootFiles": [
        ".gitignore",
        "Makefile"
      ]
    }
  }
}
