import BbTrace
import Partition

namespace BoundedMayInvestigation
open NonEmptyPolicy NonEmptyRestriction AcyclicMayCycle AcyclicMayBbTrace
open BoundedMayPartition

local instance : ReflBEq Nat where
  rfl := by intro a; exact Nat.beq_refl a
local instance : LawfulBEq Nat where
  eq_of_beq := by intro a b h; exact Nat.eq_of_beq_eq_true h

/- A tiny root-only selected cleaner. A FLOW companion excludes T, so it
   cannot substitute for the omitted surviving concrete-T query. -/
def cleanRoot (q : Seed) : List Value :=
  if q.ap.mark == some t then
    if q.ap.path.isEmpty && q.ap.tail == .exact then []
    else if q.ap.path.isEmpty && q.ap.tail == .star then
      [⟨{q.ap with tail := .may},true,true⟩]
    else [⟨q.ap,q.demand,false⟩]
  else [⟨{q.ap with mx := [t]},q.demand,false⟩]

def cleanSourceHit (v : Value) : Bool :=
  v.ap.mark == some t &&
    (match dropHead v.ap.path [f] with
     | none => false
     | some suffix => admits v.ap.tail v.ap.e suffix)

def cleanerQueries : List Seed :=
  emit 2 1 true (ap p [] .may (some t)) ⟨ap p [] .may (some t),true⟩

def exactOnly : List Seed := cleanerQueries.filter fun q =>
  !(q.ap.mark.isSome && q.ap.tail == .star)

theorem cleaner_needs_the_nonempty_branch :
    ((cleanerQueries.flatMap cleanRoot).any cleanSourceHit) = true ∧
    ((exactOnly.flatMap cleanRoot).any cleanSourceHit) = false := by decide

theorem precise_descendant_survives_the_root_cleaner :
    cleanRoot ⟨ap p [f] .exact (some t),false⟩ =
      [val (ap p [f] .exact (some t))] := by decide

/-- The extra row is generated by the actual run-3 partial loss, not a
    guessed future provider. This checks its own paired C5 budget. -/
theorem the_guard_has_a_constructive_run4_derivation :
    partialLoss ∈ fresh 3 2 false forwardRow [source] (ap p [f] .star) ∧
    restrictOne 4 3 true [sinkNeed] (ap ret [] .star)
      (val (ap p [f,g] .star)) ⟨ap ret [] .may,ap p [f] .star⟩ =
        some (ap ret [] .star,val (ap p [f,g] .star)) := by
  constructor
  · exact partial_loss_is_admitted 0 1
  · decide

def applyPrefix (read write input : Path) : Option Path :=
  (dropHead read input).map (fun suffix => write ++ suffix)

theorem dropHead_append (head suffix : Path) :
    dropHead head (head ++ suffix) = some suffix := by
  induction head with
  | nil => rfl
  | cons field fields ih => simpa [dropHead] using ih

theorem normal_provider_preserves_every_suffix (read write suffix : Path) :
    applyPrefix read write (read ++ suffix) = some (write ++ suffix) := by
  simp [applyPrefix,dropHead_append]

theorem normal_provider_covers_every_correlated_specialization
    (read write shift suffix : Path) :
    applyPrefix read write (read ++ shift ++ suffix) =
      applyPrefix (read ++ shift) (write ++ shift) (read ++ shift ++ suffix) := by
  simp only [List.append_assoc]
  rw [normal_provider_preserves_every_suffix]
  rw [← List.append_assoc read shift suffix,normal_provider_preserves_every_suffix]
  simp only [List.append_assoc]

/-- A longer reader does not necessarily produce a retained NORMAL guard
    merely because the GLOBAL limit increases. This checks the shown pair,
    not completeness of all possible future driver histories. -/
theorem a_longer_read_has_the_same_relative_cut (run k : Nat) :
    restrictOne (run+4) (k+3) true [sinkNeed] (ap ret [] .star)
      (val (ap p [f,g,3] .star)) ⟨ap ret [] .may,ap p [f] .star⟩ =
        some (ap ret [] .star,val (ap p [f,g] .ne) true) := by
  have bound : min (k+3) 2 = 2 := Nat.min_eq_right (by omega)
  unfold restrictOne
  simp only [rawImage,List.flatMap_cons,List.flatMap_nil]
  rw [show emit (run+4) (k+3) true (ap ret [] .may) sinkNeed =
    [⟨ap ret [] .exact,false⟩,⟨ap ret [] .star,false⟩] from
      backward_commands (run+2) (k+2)]
  simp [normalize,normalAp,intersectExit,selector,marksMeet,cut,bound,
    ap,val,f,g,p,ret,dropHead,admits]

/-- The next investigation can keep the public CUT PREFIX as a guard.
    No discarded suffix is stored. This is a local progress lemma, not an
    assertion that every native round uses that guard. -/
theorem the_next_cut_prefix_advances_a_growing_guard (read : Path) (depth : Nat)
    (notDone : depth < read.length) :
    (cut (depth+1) (val (ap p read .star))).ap.path.length = depth+1 ∧
    read.length - (cut (depth+1) (val (ap p read .star))).ap.path.length <
      read.length - depth := by
  by_cases long : read.length > depth+1
  · have length : (cut (depth+1) (val (ap p read .star))).ap.path.length = depth+1 := by
      simp [cut,ap,val,long,List.length_take,Nat.min_eq_left (Nat.le_of_lt long)]
    exact ⟨length,by rw [length]; omega⟩
  · have length : read.length = depth+1 := by omega
    simp [cut,ap,val,length]

/-- Existing semantic field exclusions block only the indicated first
    field. No separate promotion-ban state is used. -/
def moveChecked (fromBase toBase : Nat) (read write : Path)
    (q : Ap) : Option Value :=
  match dropHead q.path read with
  | some (field :: _) =>
    if q.e.contains field then none
    else (move fromBase toBase read write q).map fun value =>
      if value.ap.tail == .may then {value with ap := {value.ap with e := []}}
      else value
  | _ => move fromBase toBase read write q

def bodyChecked (q : Ap) : List Value :=
  [moveChecked p ret [f,g] [] q, moveChecked p ret [] [f] q].filterMap id

def regionSeed (q : Seed) (r : Region) : Seed :=
  {q with ap := {q.ap with path := q.ap.path ++ r.path,tail := r.tail,e := r.excluded}}

/-- Prototype: one retained NORMAL reader guard. A general implementation
    uses a prefix trie, and must intersect existing E rather than erase it.
    This function is deliberately gated to Empty E and FLOW STAR. -/
def refine (q : Seed) : List Seed :=
  if q.ap.mark.isNone && q.ap.tail == .star && q.ap.e.isEmpty then
    match dropHead q.ap.path [f,g] with
    | some (_ :: _) =>
      let guard := (dropHead q.ap.path [f,g]).getD []
      (partition guard).map (regionSeed q)
    | _ => [q]
  else [q]

def refineBounded (limit : Nat) (q : Seed) : List Seed :=
  let pieces := refine q
  if pieces.all (fun r => decide (r.ap.path.length ≤ limit)) then pieces
  else [q]

def newQueries (run limit : Nat) (row : Row) (a : Offered) : List Seed :=
  (emit run limit false row.entry a).flatMap (refineBounded limit)

def offeredQuery (q : Seed) : Offered := ⟨q.ap,q.demand⟩

/-- In this neutral unary prefix scope the two NORMAL branch relations
    are applied exactly as ordinary saved summaries to the original offer.
    This is not a general native alias/rule-service coverage classifier. -/
def covered (q : Ap) (c : Value) : Bool :=
  !c.demand && !c.h &&
    ((moveChecked p ret [f,g] [] q == some c) ||
     (moveChecked p ret [] [f] q == some c))

/-- Current prepared C2 image, then unchanged paired output C5. Only the
    initial-image producer changes; no normalized-key witness is invented. -/
def restrictPrepared (limit : Nat) (queries : List Seed) (raw : Ap)
    (candidate : Value) (row : Row) : Option (Ap × Value) := do
  if queries.any (fun q => decide (q.ap = raw)) then
    let n := normalize raw candidate
    let selected ← intersectExit n.2 row.exit
    return normalize n.1 (cut (min limit (row.exit.path.length+1)) selected)
  else none

def publish (limit : Nat) (queries : List Seed) (q : Seed)
    (c : Value) (row : Row) : Option (Ap × Value) :=
  if c.ap.path.length ≤ limit && covered q.ap c then none
  else restrictPrepared limit queries q.ap (cut limit c) row

def ownerPublications (run limit : Nat) (row : Row) (actual : Offered) :
    List (Ap × Value) :=
  let queries := newQueries run limit row actual
  queries.flatMap fun q =>
    (bodyChecked q.ap).filterMap fun c => publish limit queries q c row

theorem root_coarse_query_is_finitely_partitioned :
    (refine ⟨ap p [] .star,false⟩).map Seed.ap =
      [ap p [] .exact,
       {ap p [] .star with e := [f]},
       ap p [f] .exact,
       {ap p [f] .star with e := [g]},
       ap p [f,g] .star] := by decide

theorem first_coarse_query_keeps_the_known_guard :
    (refine ⟨ap p [f] .star,false⟩).map Seed.ap =
      [ap p [f] .exact,
       {ap p [f] .star with e := [g]},
       ap p [f,g] .star] := by decide

theorem an_over_limit_guard_keeps_the_complete_old_region :
    refineBounded 1 ⟨ap p [] .star,false⟩ =
      [⟨ap p [] .star,false⟩] := by decide

theorem residual_queries_do_not_recreate_the_read_loss :
    moveChecked p ret [f,g] [] {ap p [] .star with e := [f]} = none ∧
    moveChecked p ret [f,g] [] {ap p [f] .star with e := [g]} = none ∧
    moveChecked p ret [f,g] [] (ap p [f,g] .star) =
      some (val (ap ret [] .star)) := by decide

theorem an_unknown_branch_remains_open :
    moveChecked p ret [3] [] {ap p [] .star with e := [f]} =
      some (val (ap ret [] .may) true) := by decide

theorem the_bb_cut_is_covered_before_it_becomes_a_demand :
    covered firstMethodQuery (val (ap ret [f,f] .must)) = true ∧
    (cut 1 (val (ap ret [f,f] .must))).demand = true := by decide

theorem method_first_call_has_no_new_publication :
    ownerPublications 5 4 forwardRow source = [] := by decide

theorem method_may_may_call_has_no_new_publication :
    ownerPublications 5 4 forwardRow bOffer = [] := by decide

theorem bb_first_call_has_no_new_publication :
    ownerPublications 5 4 methodForward5 source = [] := by decide

theorem bb_old_second_offer_does_not_restore_the_cycle :
    ownerPublications 5 4 methodForward5 secondMethodOffer = [] := by decide

theorem new_query_does_exceed_the_old_relative_premise_bound :
    (newQueries 5 4 forwardRow source).any
      (fun q => decide (q.ap.path.length > forwardRow.entry.path.length + 1)) = true := by decide

/-- Actual caller execution: no admitted-MAY substitute and no cross-call
    evidence composition. Only the two fixed NORMAL summaries are replayed. -/
def replay (a : Offered) : List Offered :=
  (bodyChecked a.ap).map fun c =>
    ⟨{c.ap with base := p},a.demand || c.demand⟩

def firstActual : List Offered := replay source
def finalActual : List Offered := firstActual.flatMap replay

theorem actual_first_call_is_normal :
    firstActual =
      [⟨ap p [] .must (some t),false⟩,
       ⟨ap p [f,f] .must (some t),false⟩] := by decide

theorem a_wrapper_star_offer_does_not_lose_its_may_result :
    replay ⟨ap p [] .star (some t),true⟩ =
      [⟨ap p [] .may (some t),true⟩,
       ⟨ap p [f] .star (some t),true⟩] := by decide

theorem original_concrete_query_is_not_partitioned (q : Seed) (mark : Nat)
    (concrete : q.ap.mark = some mark) : refine q = [q] := by
  simp [refine,concrete]

theorem actual_second_call_is_normal :
    finalActual =
      [⟨ap p [] .must (some t),false⟩,
       ⟨ap p [f] .must (some t),false⟩,
       ⟨ap p [f,f,f] .must (some t),false⟩] := by decide

theorem no_actual_offer_or_sink_witness_is_demand :
    firstActual.all (fun a => !a.demand) = true ∧
    finalActual.all (fun a => !a.demand) = true := by decide

theorem all_actual_offers_fit_the_run5_limit :
    (firstActual ++ finalActual).all
      (fun a => decide (a.ap.path.length ≤ 4)) = true := by decide

def hasNormalFinding : Bool := finalActual.any fun a =>
  !a.demand && a.ap.mark == some t && a.ap.tail == .must

theorem the_original_sink_has_a_normal_witness : hasNormalFinding = true := by decide

/-- DATA rows are taken from computed owner publications; Target rows
    from the actual sink witnesses. No hard limit participates in this test.
    Control rules outside this declared neutral-prefix program are absent. -/
def run5Frontier (row : Row) : List Bool :=
  let owners := (ownerPublications 5 4 row source) ++
    (firstActual.flatMap (ownerPublications 5 4 row))
  owners.filterMap (fun edge => if edge.2.demand then some true else none) ++
    (finalActual.filterMap fun a => if a.demand then some true else none)

theorem method_only_natural_stop_after_run5 : run5Frontier forwardRow = [] := by decide
theorem bb_method_natural_stop_after_run5 : run5Frontier methodForward5 = [] := by decide

/-- A normal provider does not make a demanded result or a protected result
    eligible for this narrow pre-C5 rule. -/
theorem precover_does_not_retire_demand_or_protection (q : Ap) (c : Value)
    (blocked : c.demand = true ∨ c.h = true) : covered q c = false := by
  rcases blocked with d | h
  · simp [covered,d]
  · simp [covered,h]

end BoundedMayInvestigation

