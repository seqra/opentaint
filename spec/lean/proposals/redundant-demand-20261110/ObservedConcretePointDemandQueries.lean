import ConcretePointDemandQueries

namespace ObservedConcretePointDemandQueries

set_option maxRecDepth 5000
set_option maxHeartbeats 0

structure ProofRow where
  sourceOrigin : Nat
  witnessOrigin : Nat
  sourceClass : Nat
  witnessClass : Nat
  sourceOrigins : List Nat
  witnessOrigins : List Nat

def valid (removed blocked : List Nat) (r : ProofRow) : Bool :=
  r.sourceClass == r.witnessClass &&
    removed.contains r.sourceOrigin && r.sourceOrigins.contains r.sourceOrigin &&
    r.witnessOrigins.contains r.witnessOrigin && !blocked.contains r.witnessOrigin

def p0removed : List Nat := []
def p0blocked : List Nat := []

