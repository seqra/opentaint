theorem observed_native_oracles {Added Initial M Result : Type}
    [DecidableEq Initial] [DecidableEq Result]
    (admit : Pattern → Added → List Initial) (accept : Pattern → Initial → Bool)
    (collapse : Nat → Conclusion M → List Result) (global : Nat) (counted : Nat → Bool)
    (other : Nat → Request Added Initial M → List (Atom Initial Result))
    (rest : Nat → List Projection) :
    oracle (emissions db rest) (projectionReply admit accept collapse global counted other)
      (List.range 96202) =
    oracle (emissions db rest) (projectionReply admit accept collapse global counted other)
      (retained (List.range 96202) (remove 4419)) :=
  checked_native_oracles db 4419 96202 certificates (by decide) (by decide)
    all_rows_checked all_certificates_checked all_targets_complete
    admit accept collapse global counted other rest

theorem observed_all_future_iterations {Added Initial M Result State : Type}
    [DecidableEq Initial] [DecidableEq Result]
    (admit : Pattern → Added → List Initial) (accept : Pattern → Initial → Bool)
    (collapse : Nat → Conclusion M → List Result) (global : Nat) (counted : Nat → Bool)
    (other : Nat → Request Added Initial M → List (Atom Initial Result))
    (rest : Nat → List Projection)
    (step : (Request Added Initial M → Atom Initial Result → Bool) → State → State)
    (n : Nat) (initial : State) :
    iterate step (oracle (emissions db rest)
      (projectionReply admit accept collapse global counted other) (List.range 96202)) n initial =
    iterate step (oracle (emissions db rest)
      (projectionReply admit accept collapse global counted other)
      (retained (List.range 96202) (remove 4419))) n initial :=
  checked_all_future_iterations db 4419 96202 certificates (by decide) (by decide)
    all_rows_checked all_certificates_checked all_targets_complete
    admit accept collapse global counted other rest step n initial

