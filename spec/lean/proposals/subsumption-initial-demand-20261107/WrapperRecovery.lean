/-
Prepared operational E17 model, not yet checked by this child.
Dependency: the final checked PlainStarRelativeAdmissionProofFixed component.
Root must pin/check that import before claiming a result from this file.

The program has sourceExactT(); temp.g=s; next.f=temp; x=wrapF(next);
y=wrapG(x); out.Element.h=y; sinkExactT(out.Element.h).
Any finite number of ordinary wrappers may surround either getter.

All summaries/guides below are generated by field operations, C2 and paired
publication. No NORMAL getter record, initial, demand or source permission is
an external input. B2 F is DEMAND: its f.g result is cut at limit one. B3 F
is newly analyzed; only G uses the saved opposite NORMAL B2 relation.

Scope: loop-free, one path, all referenced objects initialized, FULL marks,
empty exclusions, no aliases/ND/statics/cleaners, limits 1,1,2. This models the
listed operation pipeline; native adapters for call binding, C5 output checks,
source permission and sink/Target emission remain explicit in the README.
-/
import RelativeAdmission

namespace PlainStarWrapperRecovery
open PlainStarRelativeAdmission
open ApSpec

set_option maxRecDepth 4096
set_option maxHeartbeats 8000000

def argBase : Nat := 0
def retBase : Nat := 1
def outBase : Nat := 2
def f : Nat := 0
def g : Nat := 1
def element : Nat := 2
def h : Nat := 3
def T : ScalarMark := .full 7
def p (base : Nat) (path : List Nat) (tail : Tail) (mark : ScalarMark := .flow) : Pattern :=
  ⟨base,path,tail,mark,[]⟩
def a (pat : Pattern) (layer : Layer := .normal) : Actual := ⟨pat,layer,false⟩
def b2 : Mode := ⟨2,1,.backward⟩
def f3 : Mode := ⟨3,2,.forward⟩

def bound (limit : Nat) (input : Actual) : Actual :=
  if input.pattern.path.length > limit then
    ⟨{input.pattern with path := input.pattern.path.take limit,tail := .any,exclusion := []},
      .demand,input.hasProtection⟩
  else input

structure Relation where
  initial : Pattern
  output : Actual
  deriving DecidableEq, Repr
structure Pair where
  entry : Demand
  exit : Demand
  deriving DecidableEq, Repr

def demandOf (pat : Pattern) : Demand :=
  ⟨pat.base,pat.path,
    match pat.tail with | .exact => .exact | .star => .star | .any | .must => .any,
    pat.mark,pat.exclusion⟩
def handoff (row : Relation) : Pair := ⟨demandOf row.output.pattern,demandOf row.initial⟩

def readForward (limit field : Nat) (input : Actual) : Option Actual :=
  match input.pattern.path with
  | head::rest =>
      if head = field then
        some (bound limit {input with pattern := {input.pattern with base := retBase,path := rest}})
      else none
  | [] =>
      if input.pattern.tail = .star ∨ input.pattern.tail = .any then
        some (a (p retBase [] .any input.pattern.mark) .demand)
      else none
def readBackward (limit field : Nat) (input : Actual) : Actual :=
  bound limit {input with pattern := {input.pattern with base := argBase,path := field::input.pattern.path}}

/-- Ordinary correlated application. MAY conclusions lose suffix correlation;
STAR conclusions transport the actual suffix and actual tail. Every DATA
application joins layers; a symbolic NORMAL FLOW relation cannot upgrade D. -/
def applyRelation (limit : Nat) (row : Relation) (input : Actual) : Option Actual :=
  if row.initial.base = input.pattern.base ∧ row.initial.tail = .star ∧
      RestrictedInitialPolicy.acceptsMark row.initial.mark input.pattern.mark = true then
    match dropPrefix row.initial.path input.pattern.path with
    | none => none
    | some suffix =>
        let result := row.output.pattern
        let mark := if result.mark = .flow then input.pattern.mark else result.mark
        let pat := if result.tail = .any then {result with mark := mark}
          else {result with path := result.path ++ suffix,tail := input.pattern.tail,mark := mark}
        some (bound limit ⟨pat,joinLayer row.output.layer input.layer,
          row.output.hasProtection || input.hasProtection⟩)
  else none

def run1Start (_incoming : Actual) : Actual := a (p argBase [] .star)

/-- Run-1 abstraction starts the symbolic FLOW hypothesis on the actual
non-ZERO offer. Wrapper records are emitted from applying their child's
inferred relation to that start, not supplied as input records. -/
def analyzeRun1 : Nat → Nat → Actual → Option Relation
  | 0, field, incoming => do
      let initial := run1Start incoming
      let output ← readForward 1 field initial
      pure ⟨initial.pattern,output⟩
  | n+1, field, incoming => do
      let initial := run1Start incoming
      let child ← analyzeRun1 n field initial
      let output ← applyRelation 1 child initial
      pure ⟨initial.pattern,output⟩

def r1Row : Relation := ⟨p argBase [] .star,a (p retBase [] .any) .demand⟩

theorem all_run1_wrappers_are_derived (n field : Nat) (incoming : Actual) :
    analyzeRun1 n field incoming = some r1Row := by
  induction n generalizing incoming with
  | zero => rfl
  | succ n ih =>
      simp [analyzeRun1,ih,run1Start,r1Row,applyRelation,p,a,retBase,argBase,
        RestrictedInitialPolicy.acceptsMark,bound,joinLayer,dropPrefix]

/-- These selectors are computed from the inferred row, not injected. -/
def b2Pair : Pair := handoff r1Row
theorem all_B2_guides_are_generated (n field : Nat) (incoming : Actual) :
    (analyzeRun1 n field incoming).map handoff = some b2Pair := by
  rw [all_run1_wrappers_are_derived]
  rfl
def toSeed (pat : Pattern) : Seed := ⟨pat,.normal⟩
def gSeed : Seed := toSeed (p retBase [] .star)
def fSeedB2 : Seed := toSeed (p retBase [g] .star)
def fSeedF3 : Seed := toSeed (p argBase [f,g] .star)
def gNormal : Relation := ⟨gSeed.initial,a (p argBase [g] .star)⟩
def fDemand : Relation := ⟨fSeedB2.initial,a (p argBase [f] .any) .demand⟩
def f3Pair : Pair := handoff fDemand
def fNormal : Relation := ⟨fSeedF3.initial,a (p retBase [g] .star)⟩

def exitAdmits (selector : Demand) (output : Pattern) : Bool :=
  decide (selector.base = output.base) &&
    RestrictedInitialPolicy.acceptsMark selector.mark output.mark &&
    match dropPrefix selector.path output.path with
    | none => false
    | some suffix => match selector.shape with
      | .exact => decide (suffix = [] ∧ output.tail = .exact)
      | .any => true
      | .star => (Excl.set selector.exclusion).admits suffix

/-- Prepared paired C5 for this empty-E family: use the new component's raw
entry-image predicate, the matching exit from the SAME row, and its own
conclusion budget. Keep the actual output whole when it fits that budget.
The caller supplies seed only from the actual C2 call immediately above. -/
def publish (mode : Mode) (pair : Pair) (seed : Seed) (output : Actual) : Option Relation :=
  if rawImage mode pair.entry seed.initial && exitAdmits pair.exit output.pattern then
    let result := bound (min mode.limit (pair.exit.path.length + 1)) output
    some ⟨seed.initial,result⟩
  else none

def analyzeRestricted (mode : Mode) (pair : Pair) : Nat → Nat → Actual → Option Relation
  | 0, field, incoming => do
      let seed ← emit mode pair.entry incoming
      let output ← match mode.direction with
        | .backward => some (readBackward mode.limit field (start seed))
        | .forward => readForward mode.limit field (start seed)
      publish mode pair seed output
  | n+1, field, incoming => do
      let seed ← emit mode pair.entry incoming
      let child ← analyzeRestricted mode pair n field (start seed)
      let output ← applyRelation mode.limit child (start seed)
      publish mode pair seed output

theorem b2_G_leaf_is_NORMAL :
    publish b2 b2Pair gSeed (readBackward 1 g (start gSeed)) = some gNormal := by decide
theorem b2_F_leaf_is_DEMAND :
    publish b2 b2Pair fSeedB2 (readBackward 1 f (start fSeedB2)) = some fDemand := by decide
theorem f3_F_leaf_is_NORMAL :
    (readForward 2 f (start fSeedF3)).bind (publish f3 f3Pair fSeedF3) = some fNormal := by decide
theorem g_wrapper_fixed_step :
    (applyRelation 1 gNormal (start gSeed)).bind (publish b2 b2Pair gSeed) = some gNormal := by decide
theorem f_wrapper_B2_fixed_step :
    (applyRelation 1 fDemand (start fSeedB2)).bind (publish b2 b2Pair fSeedB2) = some fDemand := by decide
theorem f_wrapper_F3_fixed_step :
    (applyRelation 2 fNormal (start fSeedF3)).bind (publish f3 f3Pair fSeedF3) = some fNormal := by decide

theorem G_internal_STAR_is_admitted : emit b2 b2Pair.entry (start gSeed) = some gSeed := by decide
theorem F_B2_internal_STAR_is_admitted : emit b2 b2Pair.entry (start fSeedB2) = some fSeedB2 := by decide
theorem F_F3_internal_STAR_is_admitted : emit f3 f3Pair.entry (start fSeedF3) = some fSeedF3 := by decide

theorem all_B2_G_wrappers_NORMAL (n : Nat) (incoming : Actual)
    (admitted : emit b2 b2Pair.entry incoming = some gSeed) :
    analyzeRestricted b2 b2Pair n g incoming = some gNormal := by
  induction n generalizing incoming with
  | zero =>
      change (emit b2 b2Pair.entry incoming).bind (fun seed =>
        publish b2 b2Pair seed (readBackward 1 g (start seed))) = some gNormal
      rw [admitted]
      exact b2_G_leaf_is_NORMAL
  | succ n ih =>
      have child := ih (start gSeed) G_internal_STAR_is_admitted
      change (emit b2 b2Pair.entry incoming).bind (fun seed =>
        (analyzeRestricted b2 b2Pair n g (start seed)).bind (fun childRow =>
          (applyRelation 1 childRow (start seed)).bind (publish b2 b2Pair seed))) = some gNormal
      rw [admitted]
      change (analyzeRestricted b2 b2Pair n g (start gSeed)).bind (fun childRow =>
        (applyRelation 1 childRow (start gSeed)).bind (publish b2 b2Pair gSeed)) = some gNormal
      rw [child]
      exact g_wrapper_fixed_step

theorem all_B2_F_wrappers_DEMAND (n : Nat) (incoming : Actual)
    (admitted : emit b2 b2Pair.entry incoming = some fSeedB2) :
    analyzeRestricted b2 b2Pair n f incoming = some fDemand := by
  induction n generalizing incoming with
  | zero =>
      change (emit b2 b2Pair.entry incoming).bind (fun seed =>
        publish b2 b2Pair seed (readBackward 1 f (start seed))) = some fDemand
      rw [admitted]
      exact b2_F_leaf_is_DEMAND
  | succ n ih =>
      have child := ih (start fSeedB2) F_B2_internal_STAR_is_admitted
      change (emit b2 b2Pair.entry incoming).bind (fun seed =>
        (analyzeRestricted b2 b2Pair n f (start seed)).bind (fun childRow =>
          (applyRelation 1 childRow (start seed)).bind (publish b2 b2Pair seed))) = some fDemand
      rw [admitted]
      change (analyzeRestricted b2 b2Pair n f (start fSeedB2)).bind (fun childRow =>
        (applyRelation 1 childRow (start fSeedB2)).bind (publish b2 b2Pair fSeedB2)) = some fDemand
      rw [child]
      exact f_wrapper_B2_fixed_step

theorem all_F3_F_wrappers_NORMAL (n : Nat) (incoming : Actual)
    (admitted : emit f3 f3Pair.entry incoming = some fSeedF3) :
    analyzeRestricted f3 f3Pair n f incoming = some fNormal := by
  induction n generalizing incoming with
  | zero =>
      change (emit f3 f3Pair.entry incoming).bind (fun seed =>
        (readForward 2 f (start seed)).bind (publish f3 f3Pair seed)) = some fNormal
      rw [admitted]
      exact f3_F_leaf_is_NORMAL
  | succ n ih =>
      have child := ih (start fSeedF3) F_F3_internal_STAR_is_admitted
      change (emit f3 f3Pair.entry incoming).bind (fun seed =>
        (analyzeRestricted f3 f3Pair n f (start seed)).bind (fun childRow =>
          (applyRelation 2 childRow (start seed)).bind (publish f3 f3Pair seed))) = some fNormal
      rw [admitted]
      change (analyzeRestricted f3 f3Pair n f (start fSeedF3)).bind (fun childRow =>
        (applyRelation 2 childRow (start fSeedF3)).bind (publish f3 f3Pair fSeedF3)) = some fNormal
      rw [child]
      exact f_wrapper_F3_fixed_step

theorem all_F3_F_guides_are_generated (n : Nat) (incoming : Actual)
    (admitted : emit b2 b2Pair.entry incoming = some fSeedB2) :
    (analyzeRestricted b2 b2Pair n f incoming).map handoff = some f3Pair := by
  rw [all_B2_F_wrappers_DEMAND n incoming admitted]
  rfl

def sourceExact : Actual := a (p argBase [] .exact T)
def writeForward (limit : Nat) (fields : List Nat) (input : Actual) : Actual :=
  bound limit {input with pattern := {input.pattern with path := fields ++ input.pattern.path}}
def nextRun1 : Actual := writeForward 1 [f] (writeForward 1 [g] sourceExact)
def nextRun3 : Actual := writeForward 2 [f] (writeForward 2 [g] sourceExact)
def rebase (base : Nat) (input : Actual) : Actual :=
  {input with pattern := {input.pattern with base := base}}

def run1RootResult : Option Actual := do
  let fRow ← analyzeRun1 0 f nextRun1
  let afterF ← applyRelation 1 fRow nextRun1
  let gRow ← analyzeRun1 0 g (rebase argBase afterF)
  let afterG ← applyRelation 1 gRow (rebase argBase afterF)
  pure (writeForward 1 [element,h] (rebase outBase afterG))

inductive Target where | normalReport | demand
  deriving DecidableEq, Repr
def observeSink (input : Actual) : Option Target :=
  if input.pattern.base = outBase ∧ input.pattern.mark = T then
    if input.pattern.path = [element,h] ∧ input.pattern.tail = .exact then
      some (if input.layer = .normal then .normalReport else .demand)
    else if input.pattern.tail = .any ∧
        (dropPrefix input.pattern.path [element,h]).isSome then some .demand else none
  else none
def r1Observation : Option Target := run1RootResult.bind observeSink

def backwardWrite (fields : List Nat) (input : Actual) : Option Actual :=
  match dropPrefix fields input.pattern.path with
  | some suffix => some {input with pattern := {input.pattern with path := suffix}}
  | none =>
      if input.pattern.tail = .any ∧ (dropPrefix input.pattern.path fields).isSome then
        some (a (p argBase [] .any input.pattern.mark) .demand)
      else none

def reverseObservedSink (observed : Target) : Option Actual := do
  match observed with
  | .normalReport => none
  | .demand => backwardWrite [element,h] (bound 1 (a (p outBase [element,h] .exact T) .demand))
def reverseSink : Option Actual := r1Observation.bind reverseObservedSink
def gBackwardOffer : Option Actual := reverseSink.map (rebase retBase)
def afterGBackward : Option Actual := do
  let incoming ← gBackwardOffer
  let row ← analyzeRestricted b2 b2Pair 0 g incoming
  applyRelation 1 row incoming
def fBackwardOffer : Option Actual := afterGBackward.map (rebase retBase)
def afterFBackward : Option Actual := do
  let incoming ← fBackwardOffer
  let row ← analyzeRestricted b2 b2Pair 0 f incoming
  applyRelation 1 row incoming
def atSourceBackward : Option Actual := do
  let incoming ← afterFBackward
  let atTemp ← backwardWrite [f] incoming
  backwardWrite [g] atTemp

/-- This is the actual reversed exact source occurrence, reached after the
derived write/getter path. Same-head MAY has possible overlap, but preserves
DEMAND support and produces source permission, not a NORMAL report. -/
def reverseActualSource (input : Actual) : Bool :=
  decide (input.pattern.mark = T ∧ input.pattern.path = [] ∧
    (input.pattern.tail = .exact ∨ input.pattern.tail = .any))
def sourcePermission : Bool := (atSourceBackward.map reverseActualSource).getD false

theorem R1_has_real_cut_and_target :
    nextRun1 = a (p argBase [f] .any T) .demand ∧ r1Observation = some .demand := by decide
theorem B2_G_has_real_MAY_offer :
    gBackwardOffer = some (a (p retBase [] .any T) .demand) := by decide
theorem B2_F_has_real_g_MAY_offer :
    fBackwardOffer = some (a (p retBase [g] .any T) .demand) := by decide
theorem source_permission_is_derived :
    atSourceBackward = some (a (p argBase [] .any T) .demand) ∧ sourcePermission = true := by decide

theorem G_external_MAY_is_admitted :
    emit b2 b2Pair.entry (a (p retBase [] .any T) .demand) = some gSeed := by decide
theorem F_B2_external_MAY_is_admitted :
    emit b2 b2Pair.entry (a (p retBase [g] .any T) .demand) = some fSeedB2 := by decide
theorem F_F3_exact_source_is_admitted :
    emit f3 f3Pair.entry nextRun3 = some fSeedF3 := by decide

def backwardSourceForWrappers (fWraps gWraps : Nat) : Option Actual := do
  let incomingG ← gBackwardOffer
  let rowG ← analyzeRestricted b2 b2Pair gWraps g incomingG
  let afterG ← applyRelation 1 rowG incomingG
  let incomingF := rebase retBase afterG
  let rowF ← analyzeRestricted b2 b2Pair fWraps f incomingF
  let afterF ← applyRelation 1 rowF incomingF
  let atTemp ← backwardWrite [f] afterF
  backwardWrite [g] atTemp
def permissionForWrappers (fWraps gWraps : Nat) : Bool :=
  ((backwardSourceForWrappers fWraps gWraps).map reverseActualSource).getD false

theorem arbitrary_wrappers_reach_actual_source (fWraps gWraps : Nat) :
    backwardSourceForWrappers fWraps gWraps =
      some (a (p argBase [] .any T) .demand) := by
  have gDerived := all_B2_G_wrappers_NORMAL gWraps
    (a (p retBase [] .any T) .demand) G_external_MAY_is_admitted
  have fDerived := all_B2_F_wrappers_DEMAND fWraps
    (a (p retBase [g] .any T) .demand) F_B2_external_MAY_is_admitted
  have applyG : applyRelation 1 gNormal (a (p retBase [] .any T) .demand) =
      some (a (p argBase [g] .any T) .demand) := by decide
  have toF : rebase retBase (a (p argBase [g] .any T) .demand) =
      a (p retBase [g] .any T) .demand := rfl
  have applyF : applyRelation 1 fDemand (a (p retBase [g] .any T) .demand) =
      some (a (p argBase [f] .any T) .demand) := by decide
  change (gBackwardOffer.bind fun incomingG =>
    (analyzeRestricted b2 b2Pair gWraps g incomingG).bind fun rowG =>
    (applyRelation 1 rowG incomingG).bind fun afterG =>
    (analyzeRestricted b2 b2Pair fWraps f (rebase retBase afterG)).bind fun rowF =>
    (applyRelation 1 rowF (rebase retBase afterG)).bind fun afterF =>
    (backwardWrite [f] afterF).bind (backwardWrite [g])) =
      some (a (p argBase [] .any T) .demand)
  simp only [B2_G_has_real_MAY_offer,Option.bind_some,gDerived,applyG,toF,fDerived,applyF]
  decide
theorem arbitrary_wrappers_source_permission (fWraps gWraps : Nat) :
    permissionForWrappers fWraps gWraps = true := by
  unfold permissionForWrappers
  rw [arbitrary_wrappers_reach_actual_source]
  decide

def savedOppositeG : Relation := ⟨gNormal.output.pattern,a gNormal.initial gNormal.output.layer⟩
def fullForward (fWraps gWraps : Nat) : Option Actual := do
  if permissionForWrappers fWraps gWraps then pure () else none
  let fRow ← analyzeRestricted f3 f3Pair fWraps f nextRun3
  let afterF ← applyRelation 2 fRow nextRun3
  -- The selected G row is derived by B2 for the actual backward offer.
  let gB2 ← analyzeRestricted b2 b2Pair gWraps g (a (p retBase [] .any T) .demand)
  let opposite : Relation := ⟨gB2.output.pattern,a gB2.initial gB2.output.layer⟩
  let afterG ← applyRelation 2 opposite (rebase argBase afterF)
  pure (writeForward 2 [element,h] (rebase outBase afterG))

theorem F_then_G_precise_application :
    (applyRelation 2 fNormal nextRun3).bind
      (fun afterF => applyRelation 2 savedOppositeG (rebase argBase afterF)) =
      some (a (p retBase [] .exact T)) := by decide
theorem MAY_application_stays_DEMAND :
    applyRelation 1 gNormal (a (p retBase [] .any T) .demand) =
      some (a (p argBase [g] .any T) .demand) := by decide
theorem MAY_application_cannot_create_NormalTarget :
    ((applyRelation 2 savedOppositeG (a (p argBase [g] .any T) .demand)).map
      (fun output => writeForward 2 [element,h] (rebase outBase output))).bind observeSink =
      some .demand := by decide

theorem arbitrary_finite_wrappers_recover (fWraps gWraps : Nat) :
    fullForward fWraps gWraps = some (a (p outBase [element,h] .exact T)) := by
  have fDerived := all_F3_F_wrappers_NORMAL fWraps nextRun3 F_F3_exact_source_is_admitted
  have gDerived := all_B2_G_wrappers_NORMAL gWraps
    (a (p retBase [] .any T) .demand) G_external_MAY_is_admitted
  unfold fullForward
  rw [arbitrary_wrappers_source_permission, fDerived, gDerived]
  decide

theorem arbitrary_finite_wrappers_report_NORMAL (fWraps gWraps : Nat) :
    (fullForward fWraps gWraps).bind observeSink = some .normalReport := by
  rw [arbitrary_finite_wrappers_recover]
  decide

/-- The uncompressed three-run pipeline: both R1 wrapper rows, both paired
guides, B2 G NORMAL, B2 F DEMAND, the source hit and the F3 current relation
are recomputed from their actual predecessor operations. No expected row or
permission is installed into this execution as an input. -/
def operationalThreeRuns (fWraps gWraps : Nat) : Option Actual := do
  let firstF ← analyzeRun1 fWraps f nextRun1
  let firstX ← applyRelation 1 firstF nextRun1
  let firstG ← analyzeRun1 gWraps g (rebase argBase firstX)
  let firstY ← applyRelation 1 firstG (rebase argBase firstX)
  let observed ← observeSink (writeForward 1 [element,h] (rebase outBase firstY))
  let backwardsY ← reverseObservedSink observed
  let offeredG := rebase retBase backwardsY
  let backwardG ← analyzeRestricted b2 (handoff firstG) gWraps g offeredG
  let backwardsX ← applyRelation 1 backwardG offeredG
  let offeredF := rebase retBase backwardsX
  let backwardF ← analyzeRestricted b2 (handoff firstF) fWraps f offeredF
  let backwardsNext ← applyRelation 1 backwardF offeredF
  let backwardsTemp ← backwardWrite [f] backwardsNext
  let backwardsSource ← backwardWrite [g] backwardsTemp
  if reverseActualSource backwardsSource then pure () else none
  let forwardF ← analyzeRestricted f3 (handoff backwardF) fWraps f nextRun3
  let forwardX ← applyRelation 2 forwardF nextRun3
  let oppositeG : Relation := ⟨backwardG.output.pattern,a backwardG.initial backwardG.output.layer⟩
  let forwardY ← applyRelation 2 oppositeG (rebase argBase forwardX)
  pure (writeForward 2 [element,h] (rebase outBase forwardY))

theorem operational_three_runs_recover (fWraps gWraps : Nat) :
    operationalThreeRuns fWraps gWraps = some (a (p outBase [element,h] .exact T)) := by
  have gDerived := all_B2_G_wrappers_NORMAL gWraps
    (a (p retBase [] .any T) .demand) G_external_MAY_is_admitted
  have fDerived := all_B2_F_wrappers_DEMAND fWraps
    (a (p retBase [g] .any T) .demand) F_B2_external_MAY_is_admitted
  have newFDerived := all_F3_F_wrappers_NORMAL fWraps nextRun3 F_F3_exact_source_is_admitted
  have firstFApply : applyRelation 1 r1Row nextRun1 =
      some (a (p retBase [] .any T) .demand) := by decide
  have firstGApply : applyRelation 1 r1Row
      (rebase argBase (a (p retBase [] .any T) .demand)) =
      some (a (p retBase [] .any T) .demand) := by decide
  have observed : observeSink
      (writeForward 1 [element,h] (rebase outBase (a (p retBase [] .any T) .demand))) =
      some .demand := by decide
  have reverseObserved : reverseObservedSink .demand =
      some (a (p argBase [] .any T) .demand) := by decide
  have toG : rebase retBase (a (p argBase [] .any T) .demand) =
      a (p retBase [] .any T) .demand := rfl
  have toF : rebase retBase (a (p argBase [g] .any T) .demand) =
      a (p retBase [g] .any T) .demand := rfl
  have applyBackwardF : applyRelation 1 fDemand (a (p retBase [g] .any T) .demand) =
      some (a (p argBase [f] .any T) .demand) := by decide
  have writeF : backwardWrite [f] (a (p argBase [f] .any T) .demand) =
      some (a (p argBase [] .any T) .demand) := by decide
  have writeG : backwardWrite [g] (a (p argBase [] .any T) .demand) =
      some (a (p argBase [] .any T) .demand) := by decide
  have permitted : reverseActualSource (a (p argBase [] .any T) .demand) = true := by decide
  have run1Handoff : handoff r1Row = b2Pair := rfl
  have fHandoff : handoff fDemand = f3Pair := rfl
  have applyForwardF : applyRelation 2 fNormal nextRun3 =
      some (a (p retBase [g] .exact T)) := by decide
  have opposite : (⟨gNormal.output.pattern,a gNormal.initial gNormal.output.layer⟩ : Relation) =
      savedOppositeG := rfl
  have applyForwardG : applyRelation 2 savedOppositeG
      (rebase argBase (a (p retBase [g] .exact T))) =
      some (a (p retBase [] .exact T)) := by decide
  change ((analyzeRun1 fWraps f nextRun1).bind fun firstF =>
    (applyRelation 1 firstF nextRun1).bind fun firstX =>
    (analyzeRun1 gWraps g (rebase argBase firstX)).bind fun firstG =>
    (applyRelation 1 firstG (rebase argBase firstX)).bind fun firstY =>
    (observeSink (writeForward 1 [element,h] (rebase outBase firstY))).bind fun observedTarget =>
    (reverseObservedSink observedTarget).bind fun backwardsY =>
    (analyzeRestricted b2 (handoff firstG) gWraps g (rebase retBase backwardsY)).bind fun backwardG =>
    (applyRelation 1 backwardG (rebase retBase backwardsY)).bind fun backwardsX =>
    (analyzeRestricted b2 (handoff firstF) fWraps f (rebase retBase backwardsX)).bind fun backwardF =>
    (applyRelation 1 backwardF (rebase retBase backwardsX)).bind fun backwardsNext =>
    (backwardWrite [f] backwardsNext).bind fun backwardsTemp =>
    (backwardWrite [g] backwardsTemp).bind fun backwardsSource =>
    if reverseActualSource backwardsSource then
      (analyzeRestricted f3 (handoff backwardF) fWraps f nextRun3).bind fun forwardF =>
      (applyRelation 2 forwardF nextRun3).bind fun forwardX =>
      (applyRelation 2
        (⟨backwardG.output.pattern,a backwardG.initial backwardG.output.layer⟩ : Relation)
        (rebase argBase forwardX)).bind fun forwardY =>
      some (writeForward 2 [element,h] (rebase outBase forwardY))
    else none) = some (a (p outBase [element,h] .exact T))
  simp only [all_run1_wrappers_are_derived,Option.bind_some,
    firstFApply,firstGApply,observed,reverseObserved,toG,toF,run1Handoff,gDerived,
    MAY_application_stays_DEMAND,fDerived,applyBackwardF,writeF,writeG,permitted,
    fHandoff,newFDerived,applyForwardF,opposite,applyForwardG]
  decide

theorem operational_three_runs_report_NORMAL (fWraps gWraps : Nat) :
    (operationalThreeRuns fWraps gWraps).bind observeSink = some .normalReport := by
  rw [operational_three_runs_recover]
  decide

theorem emitted_and_published_keys_are_not_ANY :
    gSeed.initial.tail ≠ .any ∧ fSeedB2.initial.tail ≠ .any ∧
    fSeedF3.initial.tail ≠ .any ∧ r1Row.initial.tail ≠ .any ∧
    gNormal.initial.tail ≠ .any ∧ fDemand.initial.tail ≠ .any ∧
    fNormal.initial.tail ≠ .any := by decide

/-- Exact marked-path execution of the initialized, loop-free program. At
limit two none of these concrete operations is cut. Wrappers only call and
return their child's value; they add no field operation. -/
def concreteGetter : Nat → Nat → Actual → Option Actual
  | 0, field, input => readForward 2 field input
  | n+1, field, input => concreteGetter n field input
theorem concrete_wrappers_are_returns (n field : Nat) (input : Actual) :
    concreteGetter n field input = readForward 2 field input := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [concreteGetter] using ih
def concreteRoot (fWraps gWraps : Nat) : Option Actual := do
  let afterF ← concreteGetter fWraps f nextRun3
  let afterG ← concreteGetter gWraps g (rebase argBase afterF)
  pure (writeForward 2 [element,h] (rebase outBase afterG))
theorem concrete_root_reaches_exact_T (fWraps gWraps : Nat) :
    concreteRoot fWraps gWraps = some (a (p outBase [element,h] .exact T)) := by
  simp only [concreteRoot,concrete_wrappers_are_returns]
  decide


